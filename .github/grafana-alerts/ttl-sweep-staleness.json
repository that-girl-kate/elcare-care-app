{
  "title": "TTL Sweep Staleness — No ttl_extend CleanupSummary in 72h",
  "description": "Fires when no CleanupSummaryEvent with kind=ttl_extend has been observed for the marketplace contract in the preceding 72 hours. extend_active_ttls must run at least every ~10 days (LEDGER_TTL_THRESHOLD); 72h is an early warning. See docs/guides/storage-retention.md and Issue #847.",
  "uid": "elcarehub-ttl-sweep-staleness",
  "orgId": 1,
  "condition": "C",
  "data": [
    {
      "refId": "A",
      "queryType": "",
      "relativeTimeRange": {
        "from": 259200,
        "to": 0
      },
      "datasourceUid": "${datasource}",
      "model": {
        "expr": "increase(elcarehub_cleanup_summary_total{kind=\"ttl_extend\"}[72h])",
        "intervalMs": 1000,
        "maxDataPoints": 43200,
        "refId": "A"
      }
    },
    {
      "refId": "B",
      "queryType": "",
      "relativeTimeRange": {
        "from": 259200,
        "to": 0
      },
      "datasourceUid": "__expr__",
