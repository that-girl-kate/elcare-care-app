  "noDataState": "Alerting",
  "execErrState": "Error",
  "for": "1h",
  "labels": {
    "severity": "warning",
    "team": "elcarehub-platform"
  },
  "annotations": {
    "summary": "No ttl_extend CleanupSummaryEvent in the last 72 hours — TTL keeper may be stalled",
    "description": "Marketplace persistent listings/auctions rely on extend_active_ttls refreshing TTLs before LEDGER_TTL_THRESHOLD (~10 days). Run scripts/ttl-keeper.ts manually for an emergency sweep. Runbook: docs/guides/storage-retention.md",
    "runbook_url": "https://github.com/Elcare-care/elcare-care-app/blob/main/docs/guides/storage-retention.md"
  },
